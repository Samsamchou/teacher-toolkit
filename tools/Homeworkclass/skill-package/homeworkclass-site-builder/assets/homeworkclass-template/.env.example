# Safe default: local browser demo only; no Firebase writes.
# 安全預設：只使用瀏覽器本機展示模式，不寫入 Firebase。
VITE_DATA_MODE=demo
VITE_USE_FIREBASE_EMULATORS=true

# Firebase Web App public configuration / Firebase Web App 公開識別設定
# Fill these only from the teacher-confirmed Firebase Web App settings.
# 請只從教師確認過的 Firebase Web App 設定填入；不要放通行碼或秘密值。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_FIREBASE_FUNCTIONS_REGION=asia-east1
VITE_FIREBASE_APP_CHECK_PROVIDER=recaptcha-enterprise
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Never place TEACHER_PIN_BCRYPT_HASH, RATE_LIMIT_IP_SALT, the six-digit PIN,
# service-account JSON, App Check debug tokens, or session tokens in this file.
# 絕不可在此放入 PIN 雜湊、IP 雜湊鹽、六位通行碼、服務帳戶、debug token 或 session token。
