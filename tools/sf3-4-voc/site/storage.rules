rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function teacher() {
      return request.auth != null
        && (request.auth.token.admin == true || request.auth.token.teacher == true);
    }
    match /artifacts/sf3-sf4-vocabulary-practice/audio/{allPaths=**} {
      allow read, delete: if teacher();
      allow write: if false;
    }
  }
}
