rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function teacher(uid) {
      return request.auth != null && uid == 'classroom-owner' && request.auth.uid == uid
        && request.auth.token.classroomTeacher == true
        && request.auth.token.firebase.sign_in_provider == 'custom'
        && request.auth.token.auth_time > request.time.toMillis() / 1000 - 28800;
    }
    match /teachers/{uid}/images/{imageId} {
      allow read, delete: if teacher(uid);
      allow create: if teacher(uid) && resource == null && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow update: if false;
    }
  }
}
