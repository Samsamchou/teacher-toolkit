{
  "hosting": {
    "site": "rpg-quiz-battle",
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "sprite-preview.html"],
    "headers": [
      { "source": "**/*.@(html|js|mjs|css|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(webp|png|jpg|mp3|woff2)", "headers": [{ "key": "Cache-Control", "value": "public,max-age=86400" }] }
    ]
  }
}
