rules_version = '2';
// Firestore rules for project g6-english-online-learning, (default) database.
//
// IMPORTANT: this database is shared with the english-portal app. The first block reproduces the
// rules that were live on 2026-10-18 (ruleset de93f80c-cd83-4512-bad4-990ebdd2b01d):
//     match /{document=**} { allow read, write: if request.auth != null; }
// unchanged for every collection EXCEPT `questAttempts`, which belongs to the English Mission
// Quest site (hwg5-clock-tower.web.app) and is protected by its own block below.
//
// Generated by scripts/make-rules.mjs from firestore.rules.template — edit the template, not the output.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- english-portal (unchanged behaviour for all other collections)
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null && collection != 'questAttempts';
    }

    // ---- English Mission Quest: one document per student attempt
    match /questAttempts/{attemptId} {
      function isTeacher() {
        return request.auth != null && request.auth.uid == '__TEACHER_UID__'
          && request.auth.token.firebase.sign_in_provider == 'password';
      }
      function validShape(d) {
        return d.keys().hasAll(['uid', 'mission', 'studentId', 'attemptId', 'startedAt', 'updatedAt', 'items', 'battles', 'summary'])
          && d.keys().hasOnly(['uid', 'mission', 'studentId', 'attemptId', 'startedAt', 'updatedAt', 'completedAt',
                               'stepIndex', 'stepCount', 'items', 'battles', 'summary', 'inventory', 'version',
                               'activeDays', 'expiresAt'])
          && d.mission is string && d.mission.matches('^[a-z0-9-]{3,40}$')
          && d.studentId is string && d.studentId.matches('^[0-9]{5,8}$')
          && d.attemptId == attemptId
          && d.items is list && d.items.size() <= 60
          && d.battles is map && d.summary is map
          && (!('activeDays' in d) || (d.activeDays is list && d.activeDays.size() <= 60))
          // kept 1 year 3 months after last activity (TTL policy on expiresAt deletes it)
          && (!('expiresAt' in d) || (d.expiresAt is timestamp
              && d.expiresAt > request.time && d.expiresAt < request.time + duration.value(470, 'd')));
      }
      // a student device (anonymous sign-in) creates and updates only its own attempts
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && validShape(request.resource.data);
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.mission == resource.data.mission
        && validShape(request.resource.data);
      // only the teacher account can read (students never read records back)
      allow get, list: if isTeacher();
      allow delete: if false;
    }
  }
}
