rules_version = '2';
// Firestore rules for project g6-english-online-learning, (default) database.
//
// IMPORTANT: this database is shared with the english-portal app. The first block reproduces the
// rules that were live on 2026-10-18 (ruleset de93f80c-cd83-4512-bad4-990ebdd2b01d):
//     match /{document=**} { allow read, write: if request.auth != null; }
// unchanged for every collection EXCEPT `questAttempts`, which belongs to the English Mission
// Quest site (hwg5-clock-tower.web.app) and is protected by its own block below.
//
// Generated by scripts/make-rules.mjs from firestore.rules.template — edit the template, not the output.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- english-portal (unchanged behaviour for all other collections)
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null && collection != 'questAttempts' && collection != 'questProgress'
        && collection != 'rpgAttempts';
    }

    // ---- English Mission Quest: one document per student attempt
    match /questAttempts/{attemptId} {
      function isTeacher() {
        return request.auth != null && request.auth.uid == 'z2obFrDz3jf44ip49UmVIiPvJN73'
          && request.auth.token.firebase.sign_in_provider == 'password';
      }
      function validShape(d) {
        return d.keys().hasAll(['uid', 'mission', 'studentId', 'attemptId', 'startedAt', 'updatedAt', 'items', 'battles', 'summary'])
          && d.keys().hasOnly(['uid', 'mission', 'studentId', 'attemptId', 'startedAt', 'updatedAt', 'completedAt',
                               'stepIndex', 'stepCount', 'items', 'battles', 'summary', 'inventory', 'version',
                               'activeDays', 'expiresAt'])
          && d.mission is string && d.mission.matches('^[a-z0-9-]{3,40}$')
          && d.studentId is string && d.studentId.matches('^[0-9]{5,8}$')
          && d.attemptId == attemptId
          && d.items is list && d.items.size() <= 60
          && d.battles is map && d.summary is map
          && (!('activeDays' in d) || (d.activeDays is list && d.activeDays.size() <= 60))
          // kept 1 year 3 months after last activity (TTL policy on expiresAt deletes it)
          && (!('expiresAt' in d) || (d.expiresAt is timestamp
              && d.expiresAt > request.time && d.expiresAt < request.time + duration.value(470, 'd')));
      }
      // a student device (anonymous sign-in) creates and updates only its own attempts
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && validShape(request.resource.data);
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.mission == resource.data.mission
        && validShape(request.resource.data);
      // only the teacher account can read (students never read records back)
      allow get, list: if isTeacher();
      allow delete: if false;
    }

    // ---- 時鐘塔答題大作戰（RPG 答題網站 rpg-quiz-battle.web.app）：每次作答一份文件
    // 學生裝置匿名登入，只能新增／更新自己的紀錄，讀不回；只有老師帳號能讀。沒有姓名，只有學號。
    match /rpgAttempts/{attemptId} {
      function isRpgTeacher() {
        return request.auth != null && request.auth.uid == 'z2obFrDz3jf44ip49UmVIiPvJN73'
          && request.auth.token.firebase.sign_in_provider == 'password';
      }
      function validRpg(d) {
        return d.keys().hasAll(['uid', 'quiz', 'studentId', 'attemptId', 'startedAt', 'updatedAt', 'finished',
                                'score', 'correct', 'answered', 'total', 'answers', 'game'])
          && d.keys().hasOnly(['uid', 'quiz', 'studentId', 'attemptId', 'startedAt', 'updatedAt', 'finishedAt', 'finished',
                               'score', 'correct', 'answered', 'total', 'answers', 'game', 'version', 'activeDays', 'expiresAt'])
          && d.quiz is string && d.quiz.matches('^[a-z0-9-]{3,40}$')
          && d.studentId is string && d.studentId.matches('^[3-6][0-9]{2}(0[1-9]|[12][0-9]|30)$')
          && d.attemptId == attemptId && attemptId.matches('^[0-9]{5}-[a-z0-9]{6,12}$')
          && d.finished is bool
          && d.score is int && d.score >= 0 && d.score <= 100
          && d.total is int && d.total > 0 && d.total <= 100
          && d.correct is int && d.correct >= 0 && d.correct <= d.total
          && d.answered is int && d.answered >= d.correct && d.answered <= d.total
          && d.answers is list && d.answers.size() <= 100
          && d.game is map && d.game.size() <= 12
          && (!('activeDays' in d) || (d.activeDays is list && d.activeDays.size() <= 60))
          && (!('expiresAt' in d) || (d.expiresAt is timestamp
              && d.expiresAt > request.time && d.expiresAt < request.time + duration.value(470, 'd')));
      }
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && validRpg(request.resource.data);
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.quiz == resource.data.quiz
        && validRpg(request.resource.data);
      allow get, list: if isRpgTeacher();
      allow delete: if false;
    }

    // ---- 二水 3D 英語闖關：跨裝置接續進度（教師 2026-10-21 確認不加密碼，接受「知道學號即可讀寫該學號進度」的風險）
    // 文件 ID = 任務代號_學號；只存已通關地點與各題作答狀態，沒有姓名。可以用學號讀一份，不能列出全部。
    match /questProgress/{progressId} {
      function validProgress(d) {
        return d.keys().hasAll(['mission', 'studentId', 'attemptId', 'startedAt', 'updatedAt', 'results', 'cleared'])
          && d.keys().hasOnly(['mission', 'studentId', 'attemptId', 'startedAt', 'updatedAt', 'completedAt',
                               'results', 'cleared', 'version', 'activeDays', 'expiresAt'])
          // 所有 3D 闖關任務共用：ershui-3d-quest 或 ershui-3d-quest-<代號>（例如 -hwg7）
          && d.mission is string && d.mission.matches('^ershui-3d-quest(-[a-z0-9]{2,20})?$')
          && d.studentId is string && d.studentId.matches('^[0-9]{5,8}$')
          && progressId == d.mission + '_' + d.studentId
          && d.attemptId is string && d.attemptId.size() <= 40
          && d.results is map && d.results.size() <= 60
          && d.cleared is list && d.cleared.size() <= 20
          && (!('activeDays' in d) || (d.activeDays is list && d.activeDays.size() <= 60))
          && (!('expiresAt' in d) || (d.expiresAt is timestamp
              && d.expiresAt > request.time && d.expiresAt < request.time + duration.value(470, 'd')));
      }
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null && validProgress(request.resource.data);
      allow delete: if false;
    }
  }
}
