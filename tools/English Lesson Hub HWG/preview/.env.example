# Firebase Web App configuration is public browser configuration, never an admin credential.
# Copy to .env.local for local testing or .env.production only when preparing Firebase Hosting.
# Teacher passcode remains only in Firebase Secret Manager, never in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=hwg7teaching
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-east1

# v2 opt-in only. Keep local until staging/App Check authorization and QA.
VITE_LIVE_V2_TRANSPORT=local
VITE_LIVE_APPCHECK_SITE_KEY=
