rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function anonymousTeacherMediaUploader() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function validTeacherMedia(mediaType) {
      return (mediaType == 'video'
          && request.resource.contentType == 'video/mp4'
          && request.resource.size <= 524288000)
        || (mediaType == 'presentation'
          && request.resource.contentType == 'application/pdf'
          && request.resource.size <= 524288000)
        || (mediaType == 'image'
          && (request.resource.contentType == 'image/png'
            || request.resource.contentType == 'image/jpeg'
            || request.resource.contentType == 'image/webp')
          && request.resource.size <= 20971520);
    }

    match /teacher-image-slides/{lessonId}/{fileName} {
      allow get: if anonymousTeacherMediaUploader();
      allow list: if false;
      allow create: if anonymousTeacherMediaUploader()
        && resource == null
        && lessonId.matches('^[a-z0-9-]{3,96}$')
        && fileName.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,120}$')
        && validTeacherMedia('image');
      allow update, delete: if false;
    }

    match /teacher-media/{lessonId}/{mediaType}/{fileName} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if anonymousTeacherMediaUploader()
        && lessonId.matches('^[a-z0-9-]{3,96}$')
        && fileName.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,120}$')
        && validTeacherMedia(mediaType);
      allow delete: if anonymousTeacherMediaUploader();
    }

    // v2 grants can only be issued by the verified teacher callable.
    match /liveMediaV2/{ownerUid}/{assetId}/{variant} {
      function uploadGrant() {
        return firestore.get(/databases/(default)/documents/liveMediaUploadsV2/$(assetId)).data;
      }
      allow create: if request.auth != null
        && resource == null
        && request.auth.uid == ownerUid
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && variant in ['original', 'playback']
        && uploadGrant().ownerUid == ownerUid
        && uploadGrant().active == true
        && request.time < uploadGrant().expiresAt
        && variant in uploadGrant().variants
        && request.resource.size == uploadGrant().variants[variant].bytes
        && request.resource.contentType == uploadGrant().variants[variant].mime;
      allow read, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
