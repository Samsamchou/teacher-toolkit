; Forest of Words — actual Godot combat scene; browser owns shared assessment domain.
config_version=5
[application]
config/name="Forest of Words — ImageGen Edition"
run/main_scene="res://forest.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
[display]
window/size/viewport_width=960
window/size/viewport_height=640
window/size/window_width_override=1152
window/size/window_height_override=768
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=2
environment/defaults/default_clear_color=Color(0.025,0.06,0.06,1)
